# Configuration for llm/vlm_detector/deploy.sh
#
# Copy this file to config.env and edit it:
#
#   cp config.env.example config.env
#
# config.env is ignored by git. Never commit a real API key.
# The deploy script sources this file and passes the values to nuctl.

# --- Endpoint -------------------------------------------------------------
# OpenAI-compatible base URL, including the API path (usually /v1).
# The handler adds http:// and /v1 to bare values such as "127.0.0.1:11434",
# but you should set the full URL explicitly.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Required for OpenAI and most hosted providers. Leave commented for local
# servers that do not check authentication.
# LLM_API_KEY="sk-..."
# OPENAI_API_KEY="..."        # alternative name for LLM_API_KEY

# --- Local Ollama on the Docker host --------------------------------------
# Inside the Nuclio container, localhost/127.0.0.1 is the container itself.
# Make Ollama listen on an address reachable from Docker, then use the Docker
# bridge gateway (find it with: docker network inspect cvat_cvat).
#
# On the host:
#   sudo systemctl edit ollama
#   # add:
#   [Service]
#   Environment="OLLAMA_HOST=0.0.0.0:11434"
#   sudo systemctl daemon-reload && sudo systemctl restart ollama
#
# Then uncomment and adjust:
# LLM_BASE_URL="http://172.18.0.1:11434/v1"
# LLM_MODEL="qwen2.5vl:7b"
# LLM_API_KEY="not-needed"

# --- Labels and prompt ----------------------------------------------------
# Comma-separated allow-list. Leave empty to read the label names from
# nuclio/function.yaml.
LLM_LABELS=""
# Optional custom prompt. {labels} is replaced with the allowed labels.
# LLM_PROMPT="Detect every object. Return a JSON array with label, confidence and box."

# --- Coordinates ----------------------------------------------------------
# auto | normalized | normalized_1000 | pixels
LLM_COORDINATES="auto"
# xyxy | xywh
LLM_BOX_FORMAT="xyxy"

# --- Request tuning -------------------------------------------------------
# LLM_THRESHOLD="0.5"
# LLM_TIMEOUT="100"
# LLM_MAX_RETRIES="0"
# LLM_MAX_TOKENS=""
# LLM_TEMPERATURE=""
# LLM_MAX_DETECTIONS="100"
# LLM_JPEG_QUALITY="90"
# LLM_IMAGE_DETAIL=""
# LLM_EXTRA_HEADERS=""

# --- Deployment -----------------------------------------------------------
# Docker network used by CVAT. Defaults to cvat_cvat.
# CVAT_NETWORK="cvat_cvat"

# To use a config file with a different name or location, select it from your
# shell when running the deploy script:
#   LLM_CONFIG=/path/to/other.env ./deploy.sh
